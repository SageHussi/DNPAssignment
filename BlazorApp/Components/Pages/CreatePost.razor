@page "/createpost"
@using ApiContracts
@using BlazorApp.Services
@attribute [Authorize]
@inject IPostService PostService
@inject NavigationManager Nav

<h3>Create post</h3>

<div class="mb-2">
    <label>Title</label><br />
    <input @bind="title" style="width: 400px" />
</div>
<div class="mb-2">
    <label>Body</label><br />
    <textarea @bind="body" rows="6" style="width: 400px"></textarea>
</div>

<button class="btn btn-primary" @onclick="CreateAsync">Post</button>

@if (!string.IsNullOrEmpty(message))
{
    <p class="mt-2 text-danger">@message</p>
}

@code {
    [CascadingParameter]
    public Task<AuthenticationState> State { get; set; } = default!;

    private string title = "";
    private string body = "";
    private string message = "";

    private async Task<int?> GetUserIdAsync()
    {
        ClaimsPrincipal user = (await State).User;
        if (user.Identity is null || !user.Identity.IsAuthenticated)
        {
            return null;
        }
        string? idText = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        return idText == null ? null : int.Parse(idText);
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(body))
        {
            message = "Title and body are required.";
            return;
        }

        try
        {
            int? userId = await GetUserIdAsync();
            if (userId == null)
            {
                message = "You must be logged in.";
                return;
            }

            PostDto created = await PostService.AddPostAsync(
                new CreatePostDto { Title = title, Body = body, UserId = userId.Value });

            Nav.NavigateTo($"/posts/{created.Id}");
        }
        catch (Exception e)
        {
            message = "Error: " + e.Message;
        }
    }
}